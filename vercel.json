{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "^/$",
      "status": 302,
      "headers": {
        "Location": "/Landing%20Pages/index.html"
      }
    },
    {
      "handle": "filesystem"
    }
  ]
}